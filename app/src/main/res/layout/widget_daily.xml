<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/wVerseZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/wDayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VERSE OF THE DAY"
            android:textColor="@color/green"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <TextView
            android:id="@+id/wVerse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Open OmniTools once to load your daily verse and Panchang."
            android:textColor="@color/fg"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/wRef"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text=""
            android:textColor="@color/fg_dim"
            android:textSize="11.5sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/wPanchangZone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PANCHANG  "
            android:textColor="@color/green"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <TextView
            android:id="@+id/wPanchang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="@color/fg"
            android:textSize="12.5sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/wDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/fg_dim"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
